generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql" // or postgresql/mysql if needed
  url      = env("DATABASE_URL")
}

model users{
    user_id Int @id @default(autoincrement())
    name String
    email String @unique
    profile_photo String
    xp Int
    current_streak Int @default(0)
    highest_streak Int @default(0)
    last_login DateTime @updatedAt
    salt Bytes @db.MediumBlob @default("")
    created_at DateTime @default(now())

    task task[]
    user_mood user_mood[]
    journals journals[]
    self_reflection self_reflection[]
    users_streak users_streak[]
}

model users_streak{
  user_streak_id Int @id @default(autoincrement())
  
  users users @relation(fields: [user_id], references: [user_id])
  user_id Int

  streak_id Int

  logged_at DateTime @default(now())
}

model task{
  task_id Int @id @default(autoincrement())

  users users @relation(fields: [user_id], references: [user_id])
  user_id Int

  task String
  completed Boolean

  created_at DateTime @default(now())
}

model all_moods {
  mood_id Int @id @default(autoincrement())
  mood String @unique
  mood_emoj String
  created_at DateTime @default(now())
  
  user_mood user_mood[]
}

model user_mood{
  user_mood_id Int @id @default(autoincrement())

  all_moods all_moods @relation(fields: [mood_id], references: [mood_id])
  mood_id Int

  intensity Int

  users users @relation(fields: [user_id], references: [user_id])
  user_id Int

  updated_at DateTime @updatedAt
}

model journals{
  journal_id Int @id @default(autoincrement())

  users users @relation(fields: [user_id], references: [user_id])
  user_id Int

    ciphertext Bytes @db.LongBlob
  iv Bytes

  updated_at DateTime @updatedAt
}

model prompts{
  prompt_id Int @id @default(autoincrement())
  prompt String
  description String @db.MediumText
  created_at DateTime @default(now())

}



model self_reflection{
  self_reflection_id Int @id @default(autoincrement())
  
  users users @relation(fields: [user_id], references: [user_id])
  user_id Int

  ciphertext Bytes @db.LongBlob
  iv Bytes

  updated_at DateTime @updatedAt @unique
}